{
  "name": "wardrobe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "build:demo": "VITE_ADAPTER=memory vite build --outDir dist-demo",
